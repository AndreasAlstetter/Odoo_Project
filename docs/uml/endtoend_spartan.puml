@startuml
title End-to-End Prozess EVO2 Spartan

actor Kunde
participant "Odoo Verkaufsmodul" as Sales
participant "Odoo Einkauf" as Purchase
participant "Odoo Lager" as Stock
participant "Odoo Fertigung" as MRP
participant "Shopfloor-Steuerung" as SFS

Kunde -> Sales : Kundenauftrag anlegen
Sales -> MRP : Fertigungsbedarf erzeugen

MRP -> Purchase : Bedarf an kritischen Teilen (z.B. Akku)
Purchase -> Purchase : RFQ/Bestellung anlegen
Purchase -> Stock : Wareneingang buchen
Stock -> MRP : Bestand aktualisieren

MRP -> SFS : Fertigungsauftrag freigeben

SFS -> SFS : 10 - 3D-Druck Füße (WC-3D)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 20 - 3D-Druck Haube (WC-3D)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 30 - Laserschneiden Grundplatte (WC-LC)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 40 - Nacharbeit Grundplatte (WC-NACH)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 50 - Nacharbeit Füße (WC-NACH)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 60 - Nacharbeit Haube (WC-NACH)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 70 - WT bestücken (WC-WTB)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 80 - Löten Elektronik (WC-LOET)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 90 - Montage Elektronik (WC-MONT1)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 100 - Flashen Flugcontroller (WC-FLASH)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 110 - Montage Gehäuse & Rotoren (WC-MONT2)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> SFS : 120 - End-Qualitätskontrolle (WC-QM-END)
activate SFS
SFS -> MRP : Fortschritt / Rückmeldung
deactivate SFS

SFS -> MRP : Fertigmeldung Drohne
MRP -> Stock : Fertigprodukt einlagern
Stock -> Sales : Verfügbare Drohne bereitstellen
Sales -> Kunde : Lieferung / Auftragsabschluss

@enduml