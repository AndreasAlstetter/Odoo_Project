@startuml
actor Kunde
participant "Vertrieb / Odoo" as Odoo

Kunde -> Odoo : Bedarf melden
Odoo -> Odoo : Kundenbedarf erfassen\nund Variante wählen
Odoo -> Kunde : Angebot senden
Kunde -> Odoo : Angebot akzeptieren?
alt Angebot akzeptiert
  Odoo -> Odoo : Verkaufsauftrag bestätigen
else Abgelehnt
  Odoo -> Kunde : Angebot abgelehnt / Ende
end
@enduml
